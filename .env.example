# Set this to your deployed Spring Boot backend URL in production.
# Leave empty to use relative URLs (works when frontend is served by Spring Boot).
VITE_API_BASE_URL=

# Set this to the public site origin used for canonical URLs and shared metadata.
VITE_SITE_URL=https://www.tracegraph.site

# Clerk publishable key — get it from https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
