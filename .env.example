# Backend API base URL — leave empty when served by Spring Boot directly, or set to your Hono API origin
VITE_API_BASE_URL=

# Canonical site origin for SEO / open-graph
VITE_SITE_URL=https://www.tracegraph.site

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Upstash Redis (rate limiting) ─────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── OAuth providers ───────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@tracegraph.site

# ── Session & CSRF ────────────────────────────────────────
SESSION_SECRET=change-me-32-chars-random-secret!!

# ── Internal JWT (Node → Spring Boot) ────────────────────
# Generate with: node -e "const {generateKeyPairSync}=require('crypto'); const {privateKey,publicKey}=generateKeyPairSync('ed25519'); console.log(privateKey.export({type:'pkcs8',format:'pem'})); console.log(publicKey.export({type:'spki',format:'pem'}))"
INTERNAL_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── MFA encryption (AES-GCM key, 32 bytes base64) ────────
MFA_ENCRYPTION_KEY=base64-encoded-32-byte-key

# ── WebAuthn ──────────────────────────────────────────────
WEBAUTHN_RP_ID=tracegraph.site
WEBAUTHN_ORIGIN=https://www.tracegraph.site

# ── Spring Boot backend ───────────────────────────────────
SPRING_BOOT_URL=http://localhost:8082
